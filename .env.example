DATABASE_URL=postgresql+psycopg://sdd_app:local-app-password@localhost:5432/sdd
TYPESAFE_API_KEY=
# Token maps are server-controlled: clients cannot select a tenant or reviewer name.
SDD_API_TOKENS={"replace-with-a-long-random-token":{"tenant":"demo","name":"local-owner","role":"reviewer"}}

SDD_JEV_MODEL=jev-1.13.0
SDD_JEV_TRANSPORT=systemone
# Alternatives: docs/PROVIDERS.md. Keys for custom endpoints are never inherited.
# SDD_JEV_ENDPOINT=http://127.0.0.1:9100/v1/systemone
# SDD_JEV_API_KEY=
# SDD_JEV_REVISION=weights-and-prompt-v1
# For an in-process model, use SDD_JEV_TRANSPORT=python:
# SDD_JEV_ADAPTER=my_model_adapter:create_predictor
SDD_DAILY_EVALUATIONS=1000
# For schema provisioning only: SDD_ADMIN_DATABASE_URL=...

SDD_JEV_CONCURRENCY=4
SDD_FEATURE_MAINTENANCE=1

# Optional hybrid planner; select a structured-output model available to your API account.
OPENAI_API_KEY=
SDD_LLM_TRANSPORT=openai
SDD_LLM_MODEL=
SDD_HYBRID_CONCEPTS=off
SDD_HYBRID_REPAIR=on

# Native production deployment (Compose configures these internally).
# SDD_ENV=production
# SDD_SQL_INTERFACE=1
# SDD_DB_PASSWORD_FILE=/secure/app-password
# SDD_API_TOKENS_FILE=/secure/api-tokens.json
# SDD_ADMIN_DATABASE_URL_FILE=/secure/admin-url
# Compose ports and secrets directory:
# SDD_HTTP_PORT=8000
# SDD_POSTGRES_PORT=5432
# SDD_SECRETS_DIR=.secrets
# SDD_SQL_WORKERS=2
